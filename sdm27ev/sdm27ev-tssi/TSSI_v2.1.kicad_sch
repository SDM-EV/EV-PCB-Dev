	(text "Enable must wait 50us (microseconds) after VCC is fully powered.\n50us are also needed with enable low to fully disable the esp32.\nWith the ic, enable will not start going high until the ESP is 3.3v.\nWith the pull-up and cap, it will take around 1ms for EN to become high\nso this is well above the minimum 50us needed to stay low (very close to low)\nIf EN needs to be reset, it will either be manually or internally while the ESP\nis still high, so 50us low should be ok"
		(exclude_from_sim no)
		(at 241.3 23.622 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8a077dba-107b-4822-a2cd-a2eccb0120da")
	)
